# Copy to .env and fill in. Never commit .env.
EVENTHUB_CONNECTION_STRING=
EVENTHUB_NAME=
# Microsoft Foundry: bare host, project endpoint (.../api/projects/<name>) or a pasted target URI,
# the chat model deployment name, and its API key
FOUNDRY_ENDPOINT=
FOUNDRY_MODEL_DEPLOYMENT=
FOUNDRY_API_KEY=
# Azure AI Speech (spoken commentary): key and resource region, e.g. uaenorth
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
