# Copy to .env and fill in. Never commit .env.
EVENTHUB_CONNECTION_STRING=
EVENTHUB_NAME=
# Microsoft Foundry: bare host, project endpoint (.../api/projects/<name>) or a pasted target URI,
# the chat model deployment name, and its API key
FOUNDRY_ENDPOINT=
FOUNDRY_MODEL_DEPLOYMENT=
FOUNDRY_API_KEY=
# Azure AI Translator (Arabic overlays): key, resource region, and endpoint (global or the resource's own)
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=
AZURE_TRANSLATOR_ENDPOINT=
